{
  "name": "agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + TypeScript CLI Agent with npm workspaces monorepo",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "tsx --tsconfig tsconfig.dev.json packages/cli/src/index.ts -- --web",
    "lint": "pnpm -r run lint",
    "check-types": "pnpm -r run check-types"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.2",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web-server",
    "packages/web-client"
  ]
}