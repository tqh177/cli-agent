{
  "provider": {
    "deepseek": {
      "name": "deepseek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "flash"
        },
        "deepseek-v4-pro": {
          "name": "pro"
        }
      }
    }
  },
  "storage": {
    "dir": "./data"
  },
  "tools": {
    "enabled": [
      "read_file",
      "write_file",
      "edit_file",
      "glob",
      "grep",
      "run_shell",
      "web_fetch"
    ]
  }
}
